# NEVER commit live keys or original sensitive research data.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Optional observability (Langfuse Cloud or self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional isolated Supabase project. Server-side key ONLY; never in a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Run-scoped guardrails. Daily quotas must be enforced by a separate scheduler.
MAX_MODEL_CALLS=30
MAX_RESERVED_TOKENS=350000
MAX_PAPERS_PER_RUN=16
