# NEVER commit live keys or original sensitive research data.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Optional observability (Langfuse Cloud or self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional isolated Supabase project. Server-side key ONLY; never in a browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy JWT support (do not set both; modern key above takes precedence)
SUPABASE_SERVICE_ROLE_KEY=

# Run-scoped guardrails. Daily quotas must be enforced by a separate scheduler.
MAX_MODEL_CALLS=30
MAX_RESERVED_TOKENS=350000
MAX_PAPERS_PER_RUN=16

# Opt-in live OpenAlex discovery
OPENALEX_API_KEY=
# Frontier call and token caps are per run, not shared daily reservations.
